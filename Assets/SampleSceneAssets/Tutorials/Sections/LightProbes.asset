--- !u!114 &7295098133051440698
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this tutorial, you learned what Light Probes are, how they are placed, and how to visualize them. \r\n\r\nFor more information, check out the Light Probes <a href=\"https://docs.unity3d.com/Manual/LightProbes.html\">documentation</a> and <a href=\"https://forum.unity.com/forums/global-illumination.85/\">forums.</a>\r\n\r\n<b>Note:</b> You do not need to save your changes in order to follow other tutorials."
